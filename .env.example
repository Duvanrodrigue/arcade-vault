# Formulario de contacto (/acerca) — solo servidor, nunca NEXT_PUBLIC_.
# Copia este archivo a .env.local y rellena los valores.

# API key de Resend (https://resend.com/api-keys). Empieza con re_
RESEND_API_KEY=

# Destinatario del equipo. Mientras el remitente sea onboarding@resend.dev
# (sin dominio verificado), debe ser el correo de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. Ejemplo: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>
